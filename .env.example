# Copy to .env.local for local development, and set the same variables in your host (e.g. Vercel).

# ── Launch gate ────────────────────────────────────────────────────────
# true = every URL shows only a "Coming soon" screen (nav, pages, contact form,
# sitemap all hidden; search engines told not to index). Read at build time:
# redeploy (or restart `next dev`) after changing it.
IS_COMING_SOON=false

# ── Public site settings ───────────────────────────────────────────────
# Production URL, no trailing slash. Used for canonical URLs, Open Graph, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://wyzops.com
# Public contact inbox shown on the site (mailto links, contact page, footer).
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional scheduling link (Cal.com, Calendly…). Adds "Book a call" buttons when set.
NEXT_PUBLIC_BOOKING_URL=

# ── Contact form delivery (pick one) ──────────────────────────────────
# Option 1: POST each inquiry as JSON to a webhook (Slack, Zapier, Make, n8n, your API).
CONTACT_WEBHOOK_URL=

# Option 2: Send each inquiry by email via Resend (https://resend.com).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "WyzOps Website <website@yourdomain.com>"
CONTACT_FROM_EMAIL=
